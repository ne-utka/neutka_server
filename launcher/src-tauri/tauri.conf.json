{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpringRP",
  "version": "0.1.0",
  "identifier": "com.springrp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SpringRP",
        "width": 456,
        "height": 359,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "shadow": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost https://mc-heads.net https://www.mc-heads.net https://springrp.ru"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["msi", "nsis"]
  }
}
