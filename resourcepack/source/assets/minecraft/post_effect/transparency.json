{
  "targets": {
    "scene": {},
    "bloom_a": {},
    "bloom_b": {},
    "final": {}
  },
  "passes": [
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/transparency",
      "inputs": [
        { "sampler_name": "Main", "target": "minecraft:main" },
        { "sampler_name": "MainDepth", "target": "minecraft:main", "use_depth_buffer": true },
        { "sampler_name": "Translucent", "target": "minecraft:translucent" },
        { "sampler_name": "TranslucentDepth", "target": "minecraft:translucent", "use_depth_buffer": true },
        { "sampler_name": "ItemEntity", "target": "minecraft:item_entity" },
        { "sampler_name": "ItemEntityDepth", "target": "minecraft:item_entity", "use_depth_buffer": true },
        { "sampler_name": "Particles", "target": "minecraft:particles" },
        { "sampler_name": "ParticlesDepth", "target": "minecraft:particles", "use_depth_buffer": true },
        { "sampler_name": "Clouds", "target": "minecraft:clouds" },
        { "sampler_name": "CloudsDepth", "target": "minecraft:clouds", "use_depth_buffer": true },
        { "sampler_name": "Weather", "target": "minecraft:weather" },
        { "sampler_name": "WeatherDepth", "target": "minecraft:weather", "use_depth_buffer": true }
      ],
      "output": "scene"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/neutka_bloom_extract",
      "inputs": [
        { "sampler_name": "Scene", "target": "scene" },
        { "sampler_name": "ItemEntity", "target": "minecraft:item_entity" }
      ],
      "uniforms": {
        "BloomConfig": [
          { "name": "Threshold", "type": "float", "value": 0.68 },
          { "name": "SoftKnee", "type": "float", "value": 0.22 },
          { "name": "ItemBoost", "type": "float", "value": 1.8 }
        ]
      },
      "output": "bloom_a"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/neutka_bloom_blur",
      "inputs": [
        { "sampler_name": "In", "target": "bloom_a", "bilinear": true }
      ],
      "uniforms": {
        "BlurConfig": [
          { "name": "Direction", "type": "vec2", "value": [1.0, 0.0] },
          { "name": "Radius", "type": "float", "value": 6.0 }
        ]
      },
      "output": "bloom_b"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/neutka_bloom_blur",
      "inputs": [
        { "sampler_name": "In", "target": "bloom_b", "bilinear": true }
      ],
      "uniforms": {
        "BlurConfig": [
          { "name": "Direction", "type": "vec2", "value": [0.0, 1.0] },
          { "name": "Radius", "type": "float", "value": 6.0 }
        ]
      },
      "output": "bloom_a"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/neutka_bloom_composite",
      "inputs": [
        { "sampler_name": "Scene", "target": "scene" },
        { "sampler_name": "Bloom", "target": "bloom_a", "bilinear": true }
      ],
      "uniforms": {
        "CompositeConfig": [
          { "name": "BloomStrength", "type": "float", "value": 0.85 },
          { "name": "Exposure", "type": "float", "value": 1.04 },
          { "name": "Saturation", "type": "float", "value": 1.08 },
          { "name": "VignetteStrength", "type": "float", "value": 0.14 }
        ]
      },
      "output": "final"
    },
    {
      "vertex_shader": "minecraft:core/screenquad",
      "fragment_shader": "minecraft:post/blit",
      "inputs": [
        { "sampler_name": "In", "target": "final" }
      ],
      "uniforms": {
        "BlitConfig": [
          { "name": "ColorModulate", "type": "vec4", "value": [1.0, 1.0, 1.0, 1.0] }
        ]
      },
      "output": "minecraft:main"
    }
  ]
}
